# Base de datos PostgreSQL (Supabase)
DB_HOST=tu-host.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu-password-aqui
DB_NAME=postgres

# JWT - Generar con: node -e "require('crypto').randomBytes(48).toString('hex')"
JWT_SECRET=genera-un-secret-de-al-menos-64-caracteres-aqui

# CORS - Origenes permitidos (separados por coma)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# Endpoint test-db - Header secreto
DB_TEST_SECRET=genera-otro-secreto-para-este-endpoint

# Supabase Storage (imagenes de productos)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=tu-service-key-o-anon-key
SUPABASE_BUCKET=productos

# Puerto del servidor
PORT=5000

# SSL (opcional)
# DB_SSL=true
# DB_SSL_REJECT=false
