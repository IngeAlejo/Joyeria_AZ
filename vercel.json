{
  "version": 2,
  "installCommand": "npm install",
  "outputDirectory": "www",
  "headers": [
    {
      "source": "/api/img(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=604800, immutable" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/p/:slug", "destination": "/api" }
  ]
}
